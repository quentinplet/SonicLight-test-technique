generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // ".js" specifiers resolve both under tsx (dev) and under node on the tsc output (prod).
  importFileExtension = "js"
}

// The connection URL lives in prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  userName     String   @unique @db.VarChar(60)
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  drawing Drawing?

  @@map("users")
}

model Drawing {
  id    String @id @default(uuid()) @db.Uuid
  title String @db.VarChar(80)

  /// Vector strokes, conforming to DrawingDataSchema.
  /// A document read and written whole — never queried per stroke.
  data Json @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Unique: one drawing per user, enforced by the database rather than by the code.
  /// Replacing a drawing is an upsert on this column.
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("drawings")
}
