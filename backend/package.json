{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "seed": "prisma db seed",
    "test:db": "DATABASE_URL=postgresql://soniclight:soniclight@localhost:5433/soniclight_test prisma migrate deploy"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.5",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.0",
    "vitest": "^5.0.1"
  }
}
