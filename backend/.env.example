# Copy to .env — .env is never committed.
# Variables are validated at boot by src/lib/env.ts; add a new one there first.

NODE_ENV="development"
PORT="3000"

# Origins allowed by CORS, comma-separated. Exact match: scheme included, no
# trailing slash. Never "*" — the front and the API are two distinct origins.
CLIENT_ORIGINS="http://localhost:5173"
