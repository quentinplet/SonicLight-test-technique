# Copy to .env — .env is never committed.
NODE_ENV="development"
PORT="3000"
# Postgres from docker-compose.yml, exposed on host port 5433.
DATABASE_URL="postgresql://soniclight:soniclight@localhost:5433/soniclight"
# Exact origins allowed by CORS, comma-separated. Scheme included, no trailing slash.
CLIENT_ORIGINS="http://localhost:5173"
