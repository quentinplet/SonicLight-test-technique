{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    "outDir": "dist",
    "sourceMap": true
  },
  // Typecheck covers tests, the seed and the configs too; only src/ is built (tsconfig.build.json).
  "include": ["src", "tests", "prisma/seed.ts", "prisma.config.ts", "vitest.config.ts"]
}
